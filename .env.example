# Copy to .env for local dev. In production set these in Netlify:
# Site configuration > Environment variables (never commit real values).

# --- Shopify (Partner Dashboard > Apps > OrderSheet Sync > Client credentials) ---
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SCOPES=read_orders
# Public HTTPS URL of the app. Production: https://ordersheet-sync.netlify.app (site name TBC).
# `shopify app dev` sets this to the tunnel URL locally.
SHOPIFY_APP_URL=https://ordersheet-sync.netlify.app

# --- Google Cloud (APIs & Services > Credentials > OAuth client ID, type "Web application") ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional; defaults to ${SHOPIFY_APP_URL}/google/callback
# GOOGLE_REDIRECT_URI=

# --- Security ---
# 32 random bytes as hex: openssl rand -hex 32   (NEVER change after launch: stored tokens become unreadable)
ENCRYPTION_KEY=

# --- Database: Supabase Postgres ---
# Runtime: Supabase "Transaction pooler" (Supavisor), port 6543. Keep both query params.
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1
# Migrations only (`npm run db:deploy`): "Session pooler" (port 5432) or the direct connection.
DIRECT_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
# Optional local SQLite instead of Postgres (npm run setup picks prisma/sqlite/schema.prisma):
# DATABASE_URL=file:dev.sqlite

# --- Feature flags ---
# Keep false until Shopify approves Protected Customer Data (Level 2) for name/email/address
PROTECTED_CUSTOMER_DATA_ENABLED=false
# Test charges (no real money). Defaults to true unless NODE_ENV=production. Set false for the live listing.
BILLING_TEST=true

# --- Optional serverless time budgets (ms); defaults suit Netlify's limits ---
# SCHEDULED_BUDGET_MS=25000        # scheduled function (platform limit 30s)
# MANUAL_CHUNK_BUDGET_MS=40000     # Sync now / Rebuild request (platform limit 60s)
# CONTINUE_CHUNK_BUDGET_MS=20000   # dashboard keeps a running job moving
# CALLBACK_CHUNK_BUDGET_MS=20000   # Google OAuth callback: create sheet + first pages
# WEBHOOK_INLINE_TIMEOUT_MS=4000   # inline webhook upsert (Shopify expects a reply within 5s)
# WEBHOOK_TAIL_MS=20000            # after a timeout, let the upsert finish in the background (Netlify waitUntil)
